  "spec": {
    "assumptions": [
      "原网页/原软件未核验；目录假设 HYPOTHESIS，执行代理 ADAPTED，严格复现0。",
      "目录五期RSI跨50、每笔满仓；Binance BTCUSDT现货与UTC日线为研究选择。",
      "RSI5以首5个close差值均值初始化、Wilder递推；平价50、当前严格越50才跨线。",
      "31日只预热指标；评估起始100000 USDT空仓，无预热订单在首open成交。",
      "买入本金=现金/(1+买费率)，买费=现金−本金，现金恰为0；Decimal50，不留隐形储备或容忍负现金。",
      "日close决定、下一日open全量成交；delay2第二日open；两边2bps不利滑点。",
      "原始反向cross先取消相反待成交单，与持仓无关；按实际仓位排单，同侧保留最早due。",
      "基线双边8bps，另fee0、fee20、delay2预定配置；无stop/ROI/halt，没有择优。",
      "新100%含费买持仅1个控制，首评估open买入，8bps费和2bps滑点，无期末强平。",
      "DIAGNOSTIC_ONLY；PIT/finality/成交可行性未证；已曝光2023–2024窗口，非OOS。",
      "731日含现金期，24月连续不重置；末端按rawclose盯市，不扣未发生的卖出费；无lot/部分成交建模。"
    ],
    "params": {
      "RSI5": "Close deltas at indices1..5; seed mean gain/loss at index5. Wilder alpha1/5 thereafter, prev+(x-prev)/5. Both means0 -> RSI50; loss0 gain>0 ->100; gain0 loss>0 ->0; otherwise100-100/(1+gain/loss). Five-period Wilder and flat50 are research conventions, not verified author settings.",
      "capital": {
        "Decimal_precision": 50,
        "buy_order_of_operations": [
          "fill=Decimal(raw_open)*(1+Decimal(slip_bps)/10000)",
          "notional=cash_before/(1+Decimal(fee_bps)/10000)",
          "fee=cash_before-notional",
          "quantity=notional/fill",
          "cash_after=Decimal(0)"
        ],
        "currency": "USDT",
        "entry_fee_inclusive": true,
        "fraction": "1",
        "fractional_fills": true,
        "funding_interest_borrow": 0,
        "initial_cash": "100000",
        "leverage": 1,
        "max_positions": 1,
        "rounding": "ROUND_HALF_EVEN",
        "rounding_disclosure": "fee=budget-notional closes the Decimal allocation exactly. Product quantity*fill may differ by final Decimal rounding; freeze this arithmetic order, no negative-cash tolerance/clipping, no implicit reserve, no price/tick rounding.",
        "sell_order_of_operations": [
          "fill=Decimal(raw_open)*(1-Decimal(slip_bps)/10000)",
          "notional=quantity_before*fill",
          "fee=notional*Decimal(fee_bps)/10000",
          "cash_after=cash_before+notional-fee",
          "quantity_after=Decimal(0)"
        ],
        "terminal": "mark raw last close without forced sale or unincurred exit fees; report holdings and unexecuted intent"
      },
      "cash_fraction": 1,
      "entry": "Flat and previous ready RSI<=50 and current RSI>50; equality is neutral, crossing requires strict current>50.",
      "execution": "next-open proxy;rawopposite cancellation",
      "exit": "Long and previous ready RSI>=50 and current RSI<50. At exactly50 retain current holdings. Opposite crossover cancels pending opposite intent; no persistent above50 repeated entries.",
      "fees": "fee-inclusive fullcash Decimal50",
      "metric_conventions": {
        "base_series": "731 raw daily-close equity values including cash days, with initial100000 prepended only for returns/drawdown",
        "cagr": "(E_last/100000)**(365/n)-1, n=731",
        "daily_return": "r_i=E_i/E_(i-1)-1; E_-1=100000; i=0..730",
        "exposure": "endclose bars quantity>0 divided by731; no intrabar inference",
        "fee_total": "sum exact Decimal fees; represented decimaltext",
        "floats": "Decimal values converted to float64 for numpy metrics only; no float in indicators, order eligibility, allocation, valuation",
        "max_drawdown": "min(E_i/max(100000,E_0..E_i)-1), initialanchor included",
        "monthly_counts": "fills by execution UTC month; days_long=endclose quantity>0; allzero activity months retained",
        "monthly_return": "month final equity/prior month final equity-1; firstdenominator100000; all24calendar months continuous, no reset",
        "roundtrip": "a buy followed by a sell; netpnl=sale cash_after-entry cash_before; open trade excluded from win_rate",
        "serialization": "CSV UTF8 csv.writer default CRLF; booleans0/1; missing empty; Decimal str no quantization; JSON indent2 UTF8 ensure_ascii=False allow_nan=False newline; no timestamps in deterministic results",
        "sharpe_zero_cash": "mean(r)/sample_std(r,ddof=1)*sqrt(365); null when standard deviation is0",
        "total_return": "E_last/100000-1",
        "win_rate": "strictly positive netpnl/closedroundtrips; zero included denominator; null if no closedtrade"
      },
      "period": 5,
      "smoothing": "Wilder;five-delta mean seed;flat50",
      "threshold": 50,
      "timeframe": "1d hypothesis"
    },
    "rule_excerpt": "五期RSI严格上穿50做多、严格下穿50清仓，每笔满仓；标题5日、正文五期。",
    "source_url": "https://www.quantifiedstrategies.com/bitcoin-rsi-trading-strategy/"
  },
