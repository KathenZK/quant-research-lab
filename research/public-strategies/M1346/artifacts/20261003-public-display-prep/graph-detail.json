  "name": "比特币：收盘高于25日前收盘做多、低于则卖出",
  "origin_run_id": "M1346-catalog-batch017-20261003-v1",
  "projection_activity": {
    "new_controls": 0,
    "new_strategy_trials": 0
  },
  "projection_profile": "DAILY_SAMPLED_APPROVED_DETAIL_V1",
  "projection_status": "STAGED_NOT_IMPORTED",
  "research_fidelity": "HYPOTHESIS_FROM_CATALOG_NOT_SOURCE_VERIFIED",
  "run_id": "M1346-catalog-batch017-20261003-v1",
  "source_contract": "CATALOG_CLOSE25_LEVEL_FULLCASH_REUSED_CONTROL_V1",
  "spec": {
    "assumptions": [
      "收盘高于25日前收盘为入场事件，低于为退出事件；是水平条件，不要求先发生交叉。恰好相等不产生事件，既有仓位或待单保留。无SMA、RSI或额外过滤。",
      "100000 USDT、100%含入场费仓位、Decimal50 ROUND_HALF_EVEN、两边2bps滑点、8bps基线费用。",
      "所有731个评估日与24个月连续保留；31日仅预热，不继承预热待单。",
      "已有M1258满仓买持结果按原哈希复用；新增控制0。",
      "现金不计息、不借贷、无资金费或杠杆；期末按原始收盘估值，不虚构卖出。"
    ],
    "frozen_rules_path": "../../source/root-frozen-rules.json",
    "params": {
      "metric_conventions": {
        "base_series": "731 raw daily-close equity values including cash days, with initial100000 prepended only for returns/drawdown",
        "cagr": "(E_last/100000)**(365/n)-1, n=731",
        "daily_return": "r_i=E_i/E_(i-1)-1; E_-1=100000; i=0..730",
        "exposure": "endclose bars quantity>0 divided by731; no intrabar inference",
        "fee_total": "sum exact Decimal fees; represented decimaltext",
        "floats": "Decimal values converted to float64 for numpy metrics only; no float in indicators, order eligibility, allocation, valuation",
        "max_drawdown": "min(E_i/max(100000,E_0..E_i)-1), initialanchor included",
        "monthly_counts": "fills by execution UTC month; days_long=endclose quantity>0; allzero activity months retained",
