  "spec": {
    "assumptions": [
      "HYPOTHESIS_FROM_CATALOG_NOT_SOURCE_VERIFIED / ADAPTED_EXECUTION_PROXY; strict0",
      "Catalog position fraction unspecified; fullcash fee-inclusive is explicitly selected hypothesis, not author rule.",
      "31 pre-evaluation daily bars for indicators; start allcash, no warmup intent. First evaluation close may compare prior ready feature; earliest signal-driven fill is second evaluation open.",
      "2023-01-01T00:00:00Z through2025-01-01T00:00:00Z exclusive; full24calendar months including initial cash/readiness period. Prior exposed availability-selected window, NOT OOS.",
      "Proposed Decimal50 ROUND_HALF_EVEN from original decimal CSV strings for indicators and account; recursive update prev+alpha*(x-prev), preserve exact constant input; independent implementation must match seeds/ready mask. Conversion to float only output metrics, no price rounding/tick assumptions.",
      "Endbar equity=cash+quantity*rawclose. No funding/interest, no dividend assumptions needed for spot BTC. No terminal liquidation or hypothetical exit fee; report residual inventory and pending action separately. No fill outside evaluation.",
      "base8bps/2bps each side; fee0 and fee20 retain2bps slippage; delay2 extra dailybar",
      "No author runtime equivalence, PIT/tradability not proven; no untouched OOS",
      "M1258 accepted existing fullcash100%control, no newcontrol",
      "Population ddof0; sum((close-mean)^2) in chronological order/20, then Decimal50.sqrt(); upper=mean+2*sqrt(variance), lower=mean-2*sqrt(variance).",
      "Previousready C<=upper and current C>upper; strict currentupcross, not persistent aboveupper entry.",
      "Previousready C>=middle and current C<middle; strict currentdowncross; exactmiddle equality retains position.",
      "No membership content or internal catalog curation published"
    ],
    "params": {
      "capital": {
        "Decimal_precision": 50,
        "buy_order_of_operations": [
          "fill=Decimal(raw_open)*(1+Decimal(slip_bps)/10000)",
          "notional=cash_before/(1+Decimal(fee_bps)/10000)",
          "fee=cash_before-notional",
          "quantity=notional/fill",
          "cash_after=Decimal(0)"
        ],
        "currency": "USDT",
        "entry_fee_inclusive": true,
        "fraction": "1",
        "fractional_fills": true,
        "funding_interest_borrow": 0,
        "initial_cash": "100000",
        "leverage": 1,
        "max_positions": 1,
        "rounding": "ROUND_HALF_EVEN",
        "rounding_disclosure": "fee=budget-notional closes the Decimal allocation exactly. Product quantity*fill may differ by final Decimal rounding; freeze this arithmetic order, no negative-cash tolerance/clipping, no implicit reserve, no price/tick rounding.",
        "sell_order_of_operations": [
          "fill=Decimal(raw_open)*(1-Decimal(slip_bps)/10000)",
          "notional=quantity_before*fill",
          "fee=notional*Decimal(fee_bps)/10000",
          "cash_after=cash_before+notional-fee",
          "quantity_after=Decimal(0)"
        ],
        "terminal": "mark raw last close without forced sale or unincurred exit fees; report holdings and unexecuted intent"
      },
      "entry": "Previousready C<=upper and current C>upper; strict currentupcross, not persistent aboveupper entry.",
      "exit": "Previousready C>=middle and current C<middle; strict currentdowncross; exactmiddle equality retains position.",
      "fee_bps": 8,
      "fraction": "1",
      "lag_bars": 1,
      "metric_conventions": {
        "base_series": "731 raw daily-close equity values including cash days, with initial100000 prepended only for returns/drawdown",
        "cagr": "(E_last/100000)**(365/n)-1, n=731",
        "daily_return": "r_i=E_i/E_(i-1)-1; E_-1=100000; i=0..730",
        "exposure": "endclose bars quantity>0 divided by731; no intrabar inference",
        "fee_total": "sum exact Decimal fees; represented decimaltext",
        "floats": "Decimal values converted to float64 for numpy metrics only; no float in indicators, order eligibility, allocation, valuation",
        "max_drawdown": "min(E_i/max(100000,E_0..E_i)-1), initialanchor included",
        "monthly_counts": "fills by execution UTC month; days_long=endclose quantity>0; allzero activity months retained",
        "monthly_return": "month final equity/prior month final equity-1; firstdenominator100000; all24calendar months continuous, no reset",
        "roundtrip": "a buy followed by a sell; netpnl=sale cash_after-entry cash_before; open trade excluded from win_rate",
        "serialization": "CSV UTF8 csv.writer default CRLF; booleans0/1; missing empty; Decimal str no quantization; JSON indent2 UTF8 ensure_ascii=False allow_nan=False newline; no timestamps in deterministic results",
        "sharpe_zero_cash": "mean(r)/sample_std(r,ddof=1)*sqrt(365); null when standard deviation is0",
        "total_return": "E_last/100000-1",
        "win_rate": "strictly positive netpnl/closedroundtrips; zero included denominator; null if no closedtrade"
      },
      "slippage_bps": 2,
      "source_contract": "CATALOG_BOLLINGER20X2_FULLCASH_REUSED_CONTROL_V1",
