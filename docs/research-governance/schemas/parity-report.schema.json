{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research-lab.local/schemas/parity-report.schema.json",
  "title": "Runner parity report",
  "type": "object",
  "required": [
    "schema_version", "strategy_id", "runner_kind", "runner_commit",
    "lab_commit", "snapshot_id", "gate_level", "command", "window",
    "trade_path", "conclusion", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "strategy_id": {"type": "string", "minLength": 1},
    "runner_kind": {"type": "string", "minLength": 1},
    "runner_commit": {"type": "string", "minLength": 1},
    "lab_commit": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "gate_level": {"enum": ["smoke", "parity"]},
    "command": {"type": "string", "minLength": 1},
    "window": {
      "type": "object",
      "required": ["start", "end", "bars"],
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "bars": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "trade_path": {
      "type": "object",
      "required": ["reference_trades", "runtime_trades", "path_mismatches", "fields_compared"],
      "properties": {
        "reference_trades": {"type": "integer", "minimum": 0},
        "runtime_trades": {"type": "integer", "minimum": 0},
        "path_mismatches": {"type": "integer", "minimum": 0},
        "fields_compared": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "conclusion": {"enum": ["PASS", "FAIL", "PENDING", "MISSING_EVIDENCE"]},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"conclusion": {"const": "PASS"}}},
      "then": {
        "properties": {
          "gate_level": {"const": "parity"},
          "trade_path": {
            "properties": {
              "path_mismatches": {"const": 0},
              "fields_compared": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
